@celery_app.task(
    name='celery_tasks.cleanup_old_tasks',
    max_retries=3,
    default_retry_delay=30,
    time_limit=300
)
def cleanup_old_tasks():
    """
    Очищает старые записи из БД:
    - Задачи старше 7 дней
    - Задачи в статусе 'error' старше 3 дней
    - Задачи в статусе 'completed' старше 30 дней
    """
    logger = logging.getLogger(__name__)
    logger.info("🧹 Запуск очистки старых задач...")
    
    try:
        # 1. Задачи старше 7 дней (любого статуса)
        cursor.execute("""
            DELETE FROM generations 
            WHERE created_at < NOW() - INTERVAL '7 days'
            RETURNING COUNT(*)
        """)
        old_tasks = cursor.fetchone()[0] if cursor.rowcount > 0 else 0
        
        # 2. Ошибки старше 3 дней
        cursor.execute("""
            DELETE FROM generations 
            WHERE status = 'error' 
              AND created_at < NOW() - INTERVAL '3 days'
            RETURNING COUNT(*)
        """)
        old_errors = cursor.fetchone()[0] if cursor.rowcount > 0 else 0
        
        # 3. Завершенные задачи старше 30 дней
        cursor.execute("""
            DELETE FROM generations 
            WHERE status = 'completed' 
              AND created_at < NOW() - INTERVAL '30 days'
            RETURNING COUNT(*)
        """)
        old_completed = cursor.fetchone()[0] if cursor.rowcount > 0 else 0
        
        conn.commit()
        
        logger.info(f"✅ Очистка завершена:")
        logger.info(f"   • Удалено задач старше 7 дней: {old_tasks}")
        logger.info(f"   • Удалено ошибок старше 3 дней: {old_errors}")
        logger.info(f"   • Удалено завершенных старше 30 дней: {old_completed}")
        
        return {
            'success': True,
            'old_tasks': old_tasks,
            'old_errors': old_errors,
            'old_completed': old_completed
        }
        
    except Exception as e:
        logger.error(f"❌ Ошибка при очистке задач: {e}")
        conn.rollback()
        raise
    finally:
        cursor.close()
        conn.close()


