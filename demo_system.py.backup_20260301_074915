#!/usr/bin/env python3
"""
Модуль демо-системы для AlBi Music Bot
Обрабатывает разблокировку полных версий треков за 300₽
"""
import logging
import uuid
from aiogram import types
from db_utils import execute_query_sync

logger = logging.getLogger(__name__)

def register_handlers(dp, bot):
    """Регистрирует обработчики для демо-системы"""

    @dp.callback_query_handler(lambda c: c.data.startswith('unlock_'))
    async def process_unlock_full_versions(callback_query: types.CallbackQuery):
        """Обработчик кнопки разблокировки полных версий"""
        try:
            from yookassa import Payment, Configuration
            from config import YOOKASSA_SHOP_ID, YOOKASSA_SECRET_KEY

            # Инициализируем ЮKassa API
            Configuration.account_id = YOOKASSA_SHOP_ID
            Configuration.secret_key = YOOKASSA_SECRET_KEY

            task_id = callback_query.data.replace('unlock_', '')
            user_id = callback_query.from_user.id

            logger.info(f"🔓 Запрос на разблокировку полных версий: task_id={task_id}, user_id={user_id}")

            # Проверяем, не разблокирован ли уже трек
            result = execute_query_sync(
                "SELECT is_unlocked FROM demo_tracks WHERE task_id = %s AND user_id = %s",
                (task_id, user_id)
            )

            if not result:
                await callback_query.answer("❌ Трек не найден", show_alert=True)
                return

            is_unlocked = result[0][0]
            if is_unlocked:
                await callback_query.answer("✅ Этот трек уже разблокирован!", show_alert=True)
                return

            # Создаем платеж на 300₽
            payment_id = str(uuid.uuid4())

            payment = Payment.create({
                "amount": {
                    "value": "300.00",
                    "currency": "RUB"
                },
                "confirmation": {
                    "type": "redirect",
                    "return_url": "https://t.me/ALBImusic_bot"
                },
                "capture": True,
                "description": f"Разблокировка полных версий трека",
                "metadata": {
                    "user_id": str(user_id),
                    "task_id": task_id,
                    "type": "unlock_track"
                }
            }, payment_id)

            # Сохраняем payment_id в БД
            execute_query_sync(
                "UPDATE demo_tracks SET payment_id = %s WHERE task_id = %s AND user_id = %s",
                (payment_id, task_id, user_id)
            )

            # Отправляем ссылку на оплату
            confirmation_url = payment.confirmation.confirmation_url

            keyboard = types.InlineKeyboardMarkup(row_width=1)
            keyboard.add(
                types.InlineKeyboardButton(text="💳 Оплатить 300₽", url=confirmation_url),
                types.InlineKeyboardButton(text="❌ Отменить", callback_data="cancel")
            )

            await bot.send_message(
                user_id,
                "💎 **Разблокировка полных версий**\n\n"
                "Стоимость: **300₽**\n\n"
                "После оплаты вы получите:\n"
                "🎵 Версия 1 - полная (без обрезки)\n"
                "🎵 Версия 2 - полная (без обрезки)\n\n"
                "Нажмите кнопку ниже для оплаты:",
                reply_markup=keyboard,
                parse_mode="Markdown"
            )

            await callback_query.answer("✅ Счет создан")
            logger.info(f"✅ Создан платеж {payment_id} для разблокировки task_id={task_id}")

        except Exception as e:
            logger.error(f"❌ Ошибка при создании платежа для разблокировки: {e}")
            await callback_query.answer("❌ Ошибка при создании платежа", show_alert=True)


async def check_unlock_payment(payment_id, payment_obj, bot):
    """
    Проверяет, является ли платеж разблокировкой трека
    Вызывается из webhook после успешной оплаты

    Returns:
        bool: True если это платеж за разблокировку, False иначе
    """
    try:
        # Проверяем metadata платежа
        metadata = payment_obj.get('metadata', {})
        payment_type = metadata.get('type')

        if payment_type != 'unlock_track':
            return False

        # Это платеж за разблокировку
        task_id = metadata.get('task_id')
        user_id = int(metadata.get('user_id'))

        logger.info(f"🔓 Обработка оплаты разблокировки: task_id={task_id}, user_id={user_id}")

        # Получаем полные URL из БД
        result = execute_query_sync(
            "SELECT full_url_1, full_url_2 FROM demo_tracks WHERE task_id = %s AND user_id = %s",
            (task_id, user_id)
        )

        if not result:
            logger.error(f"❌ Трек не найден в demo_tracks: task_id={task_id}")
            return True

        full_url_1, full_url_2 = result[0]

        # Отправляем полные версии пользователю
        await bot.send_message(
            user_id,
            "🎉 **Оплата прошла успешно!**\n\n"
            "Отправляю полные версии треков...",
            parse_mode="Markdown"
        )

        # Отправляем оба трека
        try:
            await bot.send_audio(
                chat_id=user_id,
                audio=full_url_1,
                caption="🎼 **Версия 1** (полная)",
                title="AI Music - Full Version 1",
                performer="ALBI Music",
                parse_mode="Markdown"
            )
        except Exception as e:
            logger.error(f"❌ Ошибка отправки версии 1: {e}")

        try:
            await bot.send_audio(
                chat_id=user_id,
                audio=full_url_2,
                caption="🎼 **Версия 2** (полная)",
                title="AI Music - Full Version 2",
                performer="ALBI Music",
                parse_mode="Markdown"
            )
        except Exception as e:
            logger.error(f"❌ Ошибка отправки версии 2: {e}")

        # Помечаем как разблокированный
        execute_query_sync(
            "UPDATE demo_tracks SET is_unlocked = TRUE, unlocked_at = NOW() WHERE task_id = %s AND user_id = %s",
            (task_id, user_id)
        )

        logger.info(f"✅ Полные версии отправлены пользователю {user_id}, task_id={task_id}")

        # Отправляем финальное сообщение с приглашением в канал
        from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
        channel_markup = InlineKeyboardMarkup()
        channel_markup.add(InlineKeyboardButton("🔔 Поделиться и смотреть примеры", url="https://t.me/ALBImusic_chart"))
        await bot.send_message(
            user_id,
            "✅ **Готово!** Наслаждайтесь полными версиями! 🎵\n\n"
            "🎉 Поделись своей песней в нашем канале — вдохнови других!\n"
            "Там же свежие примеры, промпты и обучение 👇",
            reply_markup=channel_markup,
            parse_mode="Markdown"
        )

        return True

    except Exception as e:
        logger.error(f"❌ Ошибка при обработке платежа разблокировки: {e}")
        return False
