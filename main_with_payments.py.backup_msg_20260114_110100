@dp.callback_query_handler(lambda c: c.data.startswith('post_'))
async def process_post_to_channel(callback_query: types.CallbackQuery, state: FSMContext):
    await bot.answer_callback_query(callback_query.id)
    user_id = callback_query.from_user.id
    message = callback_query.message
    
    # Извлекаем реальный audio_url из сообщения с результатом генерации
    import re
    audio_url_match = re.search(r'https?://[^\s]+', message.text)
    if audio_url_match:
        audio_url = audio_url_match.group(0)
    else:
        await bot.send_message(user_id, "❌ Не удалось найти ссылку на аудио. Попробуйте снова.")
        return
    
    # Сохраняем audio_url в состоянии
    await state.update_data(audio_url=audio_url)
    await ChannelPostStates.waiting_for_comment.set()
    
    await bot.send_message(
        user_id, 
        "📝 *Добавьте комментарий к вашей публикации:*\n\n" +
        "Напишите текст, который будет отображаться вместе с вашей песней в канале. " +
        "Например, опишите настроение, вдохновение или историю создания.", 
        parse_mode="Markdown"
    )

