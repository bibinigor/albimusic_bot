def create_generation_atomic(user_id, task_id, prompt, cost=1, is_free=False, custom_mode=False):
    """
    Атомарная операция: проверка баланса + списание + создание генерации.
    Защита от race condition через транзакцию и FOR UPDATE.
    """
    try:
        import psycopg2
        import config
        
        db_config = {
            'database': config.DB_NAME,
            'user': config.DB_USER,
            'password': config.DB_PASSWORD,
            'host': config.DB_HOST,
            'port': config.DB_PORT
        }
        
        with psycopg2.connect(**db_config) as conn:
            with conn.cursor() as cur:
                # ШАГ 1: Блокируем строку пользователя
                cur.execute("""
                    SELECT user_id, balance 
                    FROM users 
                    WHERE user_id = %s 
                    FOR UPDATE;
                """, (user_id,))
                
                user = cur.fetchone()
                if not user:
                    return {'success': False, 'error': 'Пользователь не найден'}
                
                user_id_db, balance = user
                
                # ШАГ 2: Проверяем баланс (если платная генерация)
                if not is_free and cost > 0:
                    if balance < cost:
                        conn.rollback()
                        return {'success': False, 'error': 'Недостаточно баланса'}
                    
                    # Списываем баланс
                    cur.execute("""
                        UPDATE users 
                        SET balance = balance - %s 
                        WHERE user_id = %s 
                        RETURNING balance;
                    """, (cost, user_id))
                    
                    new_balance = cur.fetchone()[0]
                else:
                    # Бесплатная генерация
                    new_balance = balance
                
                # ШАГ 3: Создаем генерацию с защитой от дублей
                cur.execute("""
                    INSERT INTO generations 
                        (user_id, task_id, prompt, is_free, custom_mode, status, created_at)
                    VALUES (%s, %s, %s, %s, %s, 'pending', NOW())
                    ON CONFLICT (user_id, task_id) DO NOTHING
                    RETURNING id;
                """, (user_id, task_id, prompt, is_free, custom_mode))
                
                result = cur.fetchone()
                
                if not result:
                    # ON CONFLICT сработал - ищем существующую генерацию
                    cur.execute("SELECT id, status FROM generations WHERE user_id = %s AND task_id = %s", (user_id, task_id))
                    existing = cur.fetchone()
                    
                    if existing:
                        generation_id, status = existing
                        import logging
                        logging.info(f"Generation already exists: user_id={user_id}, task_id={task_id}, id={generation_id}, status={status}")
                        conn.rollback()
                        return {
                            "success": True,
                            "generation_id": generation_id,
                            "already_exists": True,
                            "status": status
                        }
                    else:
                        import logging
                        logging.error(f"ON CONFLICT but no generation found: user_id={user_id}, task_id={task_id}")
                        conn.rollback()
                        return {"success": False, "error": "Внутренняя ошибка базы данных"}
                
                generation_id = result[0]
                
                # ШАГ 4: Коммитим все изменения
                conn.commit()
                
                return {
                    'success': True,
                    'generation_id': generation_id,
                    'new_balance': new_balance,
                    'message': 'Генерация успешно создана'
                }
    
    except psycopg2.Error as e:
        return {'success': False, 'error': f'Ошибка базы данных: {str(e)}'}
    except Exception as e:
        return {'success': False, 'error': f'Неожиданная ошибка: {str(e)}'}

