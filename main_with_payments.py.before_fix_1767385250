async def get_admin_stats():
    """Получить корректную статистику из PostgreSQL"""
    try:
        from db_utils import execute_query_sync
        
        # 1. Всего пользователей
        users_result = execute_query_sync("SELECT COUNT(*) as total FROM users")
        total_users = users_result[0][0] if users_result else 0
        
        # 2. Новых сегодня (из таблицы users)
        new_today_result = execute_query_sync(
            "SELECT COUNT(*) as total FROM users WHERE created_at >= CURRENT_DATE"
        )
        new_today = new_today_result[0][0] if new_today_result else 0
        
        # 3. Новых за 7 дней
        new_7days_result = execute_query_sync(
            "SELECT COUNT(*) as total FROM users WHERE created_at >= CURRENT_DATE - INTERVAL '7 days'"
        )
        new_7days = new_7days_result[0][0] if new_7days_result else 0
        
        # 4. Новых за 30 дней
        new_30days_result = execute_query_sync(
            "SELECT COUNT(*) as total FROM users WHERE created_at >= CURRENT_DATE - INTERVAL '30 days'"
        )
        new_30days = new_30days_result[0][0] if new_30days_result else 0
        
        # 5. Всего генераций
        generations_result = execute_query_sync("SELECT COUNT(*) as total FROM generations")
        total_generations = generations_result[0][0] if generations_result else 0
        
        # 6. Успешных генераций (status = 'completed')
        completed_result = execute_query_sync(
            "SELECT COUNT(*) as total FROM generations WHERE status = 'completed'"
        )
        completed_generations = completed_result[0][0] if completed_result else 0
        
        # 7. Процент успешных (избегаем деления на 0)
        success_rate = 0
        if total_generations > 0:
            success_rate = round((completed_generations / total_generations) * 100, 1)
        
        # 8. Оплаченных генераций за 7 дней (is_free = FALSE)
        paid_7days_result = execute_query_sync("""
            SELECT COUNT(*) as total FROM generations 
            WHERE created_at >= CURRENT_DATE - INTERVAL '7 days' 
            AND is_free = FALSE
        """)
        paid_generations_7days = paid_7days_result[0][0] if paid_7days_result else 0
        
        # 9. Оплаченных генераций за 24 часа
        paid_24h_result = execute_query_sync("""
            SELECT COUNT(*) as total FROM generations 
            WHERE created_at >= NOW() - INTERVAL '24 hours' 
            AND is_free = FALSE
        """)
        paid_generations_24h = paid_24h_result[0][0] if paid_24h_result else 0
        
        # 10. Приглашенных пользователей за сегодня (рефералы)
        referrals_today_result = execute_query_sync("""
            SELECT COUNT(*) as total FROM users 
            WHERE created_at >= CURRENT_DATE 
            AND invited_by IS NOT NULL
        """)
        referrals_today = referrals_today_result[0][0] if referrals_today_result else 0
        
        return {
            'total_users': total_users,
            'new_today': new_today,
            'new_7days': new_7days,
            'new_30days': new_30days,
            'total_generations': total_generations,
            'completed_generations': completed_generations,
            'success_rate': success_rate,
            'paid_generations_7days': paid_generations_7days,
            'paid_generations_24h': paid_generations_24h,
            'referrals_today': referrals_today
        }
    except Exception as e:
        logging.error(f"❌ Ошибка получения статистики: {e}")
        # Возвращаем значения по умолчанию при ошибке
        return {
            'total_users': 0,
            'new_today': 0,
            'new_7days': 0,
            'new_30days': 0,
            'total_generations': 0,
            'completed_generations': 0,
            'success_rate': 0,
            'paid_generations_7days': 0,
            'paid_generations_24h': 0,
            'referrals_today': 0
        }
    return "1014"

