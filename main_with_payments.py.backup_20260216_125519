@app.post("/webhook/yookassa")
async def yookassa_webhook(request: Request):
    try:
        notification = await request.json()
        logging.info(f"Webhook от ЮKassa: {notification}")
        if notification.get('event') == 'payment.succeeded':
            payment = notification.get('object', {})
            payment_id = payment.get('id')

            # Проверяем, не является ли это платежом за разблокировку трека
            if await demo_system.check_unlock_payment(payment_id, payment, bot):
                return JSONResponse({"status": "ok"})

            # Обработка обычных платежей за генерации
            user_id = payment.get('metadata', {}).get('user_id')
            amount = float(payment.get('amount', {}).get('value', 0))
            if user_id and amount:
                # Определяем количество генераций по сумме
                amount_to_generations = {
                    490.00: 10,
                    990.00: 25,
                    1990.00: 60,
                    3990.00: 140
                }

                generations = amount_to_generations.get(amount, 1)  # По умолчанию 1 если сумма неизвестна

                add_balance(user_id, generations)
                add_payment(user_id, amount, 'succeeded', payment.get('id'))
                logging.info(f"✅ Начислено {generations} генераций пользователю {user_id}")

                tracks_count = generations * 2
                try:
                    await bot.send_message(
                        user_id,
                        f"✅ Оплата получена!\n\n"
                        f"💰 На ваш баланс начислено: {generations} генераций ({tracks_count} треков)\n\n"
                        f"🎵 Теперь вы можете создавать музыку!"
                    )
                except Exception as e:
                    logging.error(f"❌ Не удалось отправить уведомление пользователю {user_id}: {e}")
                return JSONResponse({"status": "ok"})
        return JSONResponse({"status": "ignored"})
    except Exception as e:
        logging.error(f"❌ Ошибка webhook: {e}")
        return JSONResponse({"status": "error"}, status_code=400)

