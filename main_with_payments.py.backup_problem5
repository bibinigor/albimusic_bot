@app.post("/webhook/yookassa")
async def yookassa_webhook(request: Request):
    try:
        notification = await request.json()
        logging.info(f"Webhook от ЮKassa: {notification}")
        if notification.get('event') == 'payment.succeeded':
            payment = notification.get('object', {})
            user_id = payment.get('metadata', {}).get('user_id')
            amount = float(payment.get('amount', {}).get('value', 0))
            if user_id and amount:
                if amount == 50.00:
                    generations = 1
                elif amount == 400.00:
                    generations = 10
                else:
                    generations = 1
                add_balance(user_id, generations)
                add_payment(user_id, amount, 'succeeded', payment.get('id'))
                logging.info(f"✅ Начислено {generations} генераций пользователю {user_id}")
                try:
                    await bot.send_message(user_id, f"✅ Оплата получена!\n\n💰 На ваш баланс начислено: {generations} генераций\n\n🎵 Теперь вы можете создавать песни!")
                except Exception as e:
                    logging.error(f"❌ Не удалось отправить уведомление пользователю {user_id}: {e}")
