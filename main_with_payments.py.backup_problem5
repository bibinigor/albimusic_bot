def add_generation(user_id, task_id, prompt, audio_url, is_free=False, custom_mode=False):
    """Добавление генерации с защитой от race condition"""
    try:
        from db_utils import execute_query_sync
        
        # Единый INSERT с ON CONFLICT - защита от дублей и race condition
        result = execute_query_sync(
            'INSERT INTO generations (user_id, task_id, prompt, audio_url, is_free, custom_mode, status, created_at) VALUES (%s, %s, %s, %s, %s, %s, %s, NOW()) ON CONFLICT (user_id, task_id) DO NOTHING RETURNING id', 
            (user_id, task_id, prompt, audio_url, is_free, custom_mode, 'pending'),
            fetch_one=True
        )
        
        if result:
            logging.info(f"✅ Добавлена генерация {task_id} для пользователя {user_id}")
            return True
        else:
            logging.info(f"⚠️  Задача {task_id} уже существует (ON CONFLICT сработал)")
            return False
        
        if result:
            logging.info(f"✅ Добавлена генерация {task_id} для пользователя {user_id}")
            return True
        else:
            logging.error(f"❌ Не удалось добавить генерацию {task_id} для пользователя {user_id}")
            return False
            
    except Exception as e:
        logging.error(f"❌ Ошибка добавления генерации {user_id}: {e}")
        return False

