async def process_generation_background(user_id, style, lyrics, is_song, is_free, custom_mode, processing_msg_id, chat_id):
    try:
        logging.info(f"🔍 ВХОД В process_generation_background: user={user_id}, song={is_song}, style={style[:50]}...")
        
        # Отправляем задачу в Celery
        logging.info(f"🎵 ВЫЗОВ CELERY: is_song={is_song}, user={user_id}")
        if is_song:
            task = generate_song_task.delay(user_id, lyrics, style, custom_mode)
        else:
            task = generate_music_task.delay(user_id, f'{style}. {custom_mode}' if custom_mode else style)
        
        logging.info(f"✅ Celery task создана: id={task.id if task else 'NONE'}")
        logging.info(f"🚀 Задача отправлена в Celery: {task.id} для пользователя {user_id}")
        
        # Сохраняем task_id в БД
        add_generation(user_id, task.id, f"Стиль: {style}" + (f". Текст: {lyrics}" if is_song else ""), "", is_free, custom_mode)
        
        # Отправляем сообщение о начале обработки
        await bot.send_message(chat_id, "⏳ **Генерация вашей композиции началась!**\n\n⏰ Подождите пожалуйста 3-5 минут. Результат я пришлю вам сюда в чат!\n\n🎶 Если композиция вам понравится, то вы сразу сможете разместить ее в нашем канале ALBImusic_Chart и послушать работы других пользователей.", )
        
        try:
            await bot.delete_message(chat_id, processing_msg_id)
        except:
            pass
            
    except Exception as e:
        logging.error(f"❌ Ошибка отправки задачи в Celery: {e}")
        try:
            await bot.delete_message(chat_id, processing_msg_id)
        except:
            pass
        await bot.send_message(chat_id, "❌ Произошла ошибка при постановке задачи в очередь. Попробуйте позже.")

